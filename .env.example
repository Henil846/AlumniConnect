# Application Environment: 'production', 'development', 'local', or 'testing'.
# IMPORTANT: If APP_ENV is omitted or empty, the application FAILS CLOSED to 'production' mode
# (demo seeding is strictly blocked, DB_PATH test overrides are rejected, and error details are hidden).
APP_ENV=local
APP_URL=http://localhost:8000
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_SECRET_KEY

# Cross-Tenant Profile Visibility: 'true' or 'false' (default: false).
# TRADE-OFF:
# When set to 'true', students and alumni can view public profiles across institutions to foster
# nationwide inter-collegiate networking, mentorship discovery, and job referrals.
# When set to 'false' (default), strict multi-tenant data isolation is enforced; users can only
# view profiles belonging to their own college/institution (super_admin retains platform-wide access).
CROSS_TENANT_PROFILES=false

